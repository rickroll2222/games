}#␀␀␀¡␀␀␀/tf/materials/lights/white_fill.vmt"UnlitGeneric"
{
	"$basetexture" "Lights/White002"
	"$selfillum" 1
	"$surfaceprop" "glass"
	"$reflectivity" "[0 0 0]"
	"$nodecal" "1"
	"%keywords" "tf"
}#␀␀␀o␀␀/tf/materials/overlays/no_entry.vmt"UnlitGeneric"
{
	"$baseTexture" "overlays/no_entry"
	"$translucent" 1
//	"$vertexcolor" "1"
//	"$vertexalpha" "1"
	"$nodecal" "1"
	"%compiletrigger" 1
	"%keywords" "tf"

	$softedges 1
	$edgesoftnessstart 0.6
	$edgesoftnessend 0.5

	$outline 1
	$outlinecolor "[0 0 0]"
	$outlinealpha 1

	$outlinestart0 0.4
	$outlinestart1 0.52
	$outlineend0 0.8
	$outlineend1 0.92


//	$alphatest 1
//	$alphatestreference .5


	"$playerdistance"	"0"
	"$distanceclamped"	"0"
	"$distanceinverted"	"0"
	"$teammatch"		"0"
	"$matchinverted"	"0"
	"$endalpha"		"0"
	"$one"			"2"
	"$fadedistance"		"800"
	$distancealpha 1

	"Proxies"
	{
		"PlayerProximity"
		{
			"resultVar" "$playerdistance"
			"scale"  1.0
		}	
		"Clamp"
		{
			"srcVar1"	"$playerdistance"
			"min"		"0"
			"max"		"$fadedistance"
			"resultVar" 	"$distanceclamped"
		}
		"Subtract"
		{
			"srcVar1"	"$fadedistance"
			"srcVar2"	"$distanceclamped"
			"resultVar"	"$distanceinverted"
		}
		"PlayerTeamMatch"
		{
			"resultVar"	"$teammatch"
		}
		"Subtract"
		{
			"srcVar1"	"$one"
			"srcVar2"	"$teammatch"
			"resultVar"	"$matchinverted"	
		}
		"Divide"
		{
			"srcVar1"	"$distanceinverted"
			"srcVar2"	"$fadedistance"
			"resultVar" 	"$endalpha"		
		}
		"Multiply"
		{
			"srcVar1"	"$endalpha"		
			"srcVar2"	"$matchinverted"	
			"resultVar" 	"$alpha"	
		}
	}
}
